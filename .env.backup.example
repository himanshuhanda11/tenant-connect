# ============================================================
# Aireatro – BACKUP Supabase env file (NOT YET ACTIVE)
# ============================================================
# This file is a TEMPLATE for switching the app to your own
# Supabase project in the future. The live app currently uses
# Lovable Cloud and ignores this file.
#
# When you're ready to switch, copy these into Vercel /
# Cloudflare Pages env settings (NOT into the Lovable repo).
# ============================================================

# --- Frontend (safe to expose) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# --- Backend / Edge Functions only (NEVER expose) ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...same-as-VITE_SUPABASE_ANON_KEY...

# --- Meta / WhatsApp ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=aireatro_verify
WHATSAPP_SYSTEM_USER_TOKEN=

# --- Instagram ---
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=admin@aireatro.com

# --- AI ---
LOVABLE_API_KEY=
# OR if leaving Lovable AI Gateway:
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# --- Shopify ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
